---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="wrap narrow">
    <header class="page-head">
      <h1>Page not found</h1>
      <p>Sorry, there is nothing at this address.</p>
    </header>
    <div class="prose">
      <p>
        Every post is still at its original address. Try the <a href="/">home page</a>, browse
        <a href="/topics/">by topic</a> or <a href="/years/">by year</a>, or <a href="/search/">search</a>.
      </p>
    </div>
  </div>
</Base>
