---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import AiIcon from '../components/AiIcon.astro';
import {
  formatDate,
  formatLongDate,
  getPosts,
  hasDuplicateTitle,
  imageCount,
  isoDate,
  postUrl,
  readingLabel,
  topicOf,
  topicUrl,
} from '../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const topic = topicOf(post);
    const sameTopic = posts.filter((p) => p.data.topic === post.data.topic && p.id !== post.id);
    return {
      // "/2013/11/swaying-branches.html" is built from "2013/11/swaying-branches" (build.format: 'preserve').
      params: { permalink: post.data.permalink.slice(1).replace(/\.html$/, '') },
      props: {
        post,
        topic,
        related: sameTopic.slice(0, 6),
        relatedTotal: sameTopic.length,
        older: posts[i - 1],
        newer: posts[i + 1],
        duplicateTitle: hasDuplicateTitle(post, posts),
      },
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, topic, related, relatedTotal, older, newer, duplicateTitle } = Astro.props;
const { Content } = await render(post);
const { title, date, summary, summary_long, summary_reviewed, tags, blogger_url, see_also } = post.data;
const pageTitle = duplicateTitle ? `${title} (${formatDate(date)})` : title;
const summaryLabel = summary_reviewed
  ? 'Summary · AI-generated, reviewed by family'
  : 'Summary · AI-generated, not yet reviewed by family';
const isGallery = imageCount(post) >= 10;
---

<Base title={pageTitle} description={summary}>
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
  </Fragment>
  <div class="wrap narrow">
    <article class="post">
      <header class="post-header">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href={topicUrl(topic)}>{topic.name}</a></li>
          </ol>
        </nav>
        <h1 data-pagefind-meta="title">{title}</h1>
        <p class="meta">
          <time datetime={isoDate(date)} data-pagefind-meta="date">{formatLongDate(date)}</time>
          <span class="dot" aria-hidden="true">·</span>
          <a href={topicUrl(topic)} data-pagefind-filter="topic">{topic.name}</a>
          <span class="dot" aria-hidden="true">·</span>
          {readingLabel(post)}
        </p>
      </header>

      <aside class="summary-box" aria-labelledby="summary-label" data-pagefind-body data-pagefind-weight="0.5">
        <p class="summary-label" id="summary-label" data-pagefind-ignore>
          <AiIcon />
          {summaryLabel}
        </p>
        <p class="summary-text">{summary_long}</p>
        <a class="summary-about" href="/about/#summaries" data-pagefind-ignore>How these summaries were made</a>
      </aside>

      {
        see_also && (
          <p class="see-also" data-pagefind-ignore>
            <a href={see_also.url}>{see_also.text} →</a>
          </p>
        )
      }

      <div class:list={['prose', { 'is-gallery': isGallery }]} data-post-body data-pagefind-body data-pagefind-weight="2">
        <Content />
      </div>
    </article>

    <footer class="post-footer">
      <div class="original-link">
        <p>
          <a href={blogger_url}>Original on Blogspot</a>
        </p>
        {
          tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 id="related-heading">More in {topic.name}</h2>
            <PostList posts={related} summaries={false} />
            {relatedTotal > related.length && (
              <p>
                <a href={topicUrl(topic)}>
                  All {relatedTotal + 1} posts in {topic.name}
                </a>
              </p>
            )}
          </section>
        )
      }

      <nav class="pager" aria-label="Older and newer posts">
        {
          older && (
            <a class="prev" href={postUrl(older)} rel="prev">
              <span class="label">← Older</span>
              <span class="title">{older.data.title}</span>
              <time datetime={isoDate(older.data.date)}>{formatDate(older.data.date)}</time>
            </a>
          )
        }
        {
          newer && (
            <a class="next" href={postUrl(newer)} rel="next">
              <span class="label">Newer →</span>
              <span class="title">{newer.data.title}</span>
              <time datetime={isoDate(newer.data.date)}>{formatDate(newer.data.date)}</time>
            </a>
          )
        }
      </nav>
    </footer>
  </div>
</Base>
